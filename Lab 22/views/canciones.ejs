<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>
<section class="section">
  <div class="container">
    <h1 class="title">Playlist para pasar el bloque con 100</h1>
    <p class="subtitle"><%= canciones.length %> canciones guardadas</p>
    <div class="buttons mb-5">
      <% for (let p of privilegios) { %>
        <% if (p.privilegio === 'crear_canciones') { %>
          <a href="/canciones/new" class="button is-primary">Agregar canción</a>
        <% } %>
      <% } %>
      <a href="/" class="button is-light">Inicio</a>
    </div>
    <div class="columns is-multiline">
      <% for (let cancion of canciones) { %>
        <div class="column is-one-quarter-desktop is-half-tablet">
          <div class="card tarjeta">
            <div class="card-image">
              <figure class="image is-1by1">
                <img
                src="<%= cancion.imagen && cancion.imagen.startsWith('http') ? cancion.imagen : '/uploads/' + cancion.imagen %>"
                alt="Portada de <%= cancion.titulo %>"
                style="object-fit: cover; width: 100%; height: 100%;">
              </figure>
            </div>
            <div class="card-content">
              <p class="title is-5"><%= cancion.titulo %></p>
              <p class="subtitle is-6"><%= cancion.artista %></p>
              <div class="buttons mt-3">
                <a href="/canciones/<%= cancion.id %>" class="button is-info is-small">Ver</a>
                <% for (let p of privilegios) { %>
                  <% if (p.privilegio === 'editar_canciones') { %>
                    <a href="/canciones/<%= cancion.id %>/edit" class="button is-warning is-small">Editar</a>
                  <% } %>
                  <% if (p.privilegio === 'eliminar_canciones') { %>
                    <form action="/canciones/delete" method="POST" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="id" value="<%= cancion.id %>">
                      <button class="button is-danger is-small" type="submit">Eliminar</button>
                    </form>
                  <% } %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>
<%- include('includes/footer.ejs') %>