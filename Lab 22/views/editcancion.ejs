<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>

<section class="section">
  <div class="container">
    <h1 class="title">Editar canción</h1>

    <form action="/canciones/<%= cancion.id %>/edit" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="imagenActual" value="<%= cancion.imagen %>">

      <div class="field">
        <label class="label">Título</label>
        <div class="control">
          <input class="input" type="text" name="titulo" value="<%= cancion.titulo %>">
        </div>
      </div>

      <div class="field">
        <label class="label">Artista</label>
        <div class="control">
          <input class="input" type="text" name="artista" value="<%= cancion.artista %>">
        </div>
      </div>

      <% if (cancion.imagen) { %>
        <div class="field">
          <label class="label">Imagen actual</label>
          <figure class="image is-128x128">
            <img src="/uploads/<%= cancion.imagen %>" alt="Portada actual">
          </figure>
        </div>
      <% } %>

      <div class="field">
        <label class="label">Nueva imagen</label>
        <div class="control">
          <input class="input" type="file" name="imagen" accept=".png,.jpg,.jpeg">
        </div>
      </div>

      <div class="buttons">
        <button class="button is-warning" type="submit">Guardar cambios</button>
        <a href="/canciones" class="button is-light">Cancelar</a>
      </div>
    </form>
  </div>
</section>

<%- include('includes/footer.ejs') %>