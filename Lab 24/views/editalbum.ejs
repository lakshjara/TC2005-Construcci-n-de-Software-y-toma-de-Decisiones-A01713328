<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>

<section class="section">
  <div class="container">
    <h1 class="title">Editar álbum</h1>

    <form action="/albumes/<%= album.id %>/edit" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="imagenActual" value="<%= album.imagen %>">

      <div class="field">
        <label class="label">Título</label>
        <div class="control">
          <input class="input" type="text" name="titulo" value="<%= album.titulo %>">
        </div>
      </div>

      <div class="field">
        <label class="label">Artista</label>
        <div class="control">
          <input class="input" type="text" name="artista" value="<%= album.artista %>">
        </div>
      </div>

      <div class="field">
        <label class="label">Año</label>
        <div class="control">
          <input class="input" type="text" name="anio" value="<%= album.anio %>">
        </div>
      </div>

      <% if (album.imagen) { %>
        <div class="field">
          <label class="label">Imagen actual</label>
          <figure class="image is-128x128">
            <img src="/uploads/<%= album.imagen %>" alt="Portada actual">
          </figure>
        </div>
      <% } %>

      <div class="field">
        <label class="label">Nueva imagen</label>
        <div class="control">
          <input class="input" type="file" name="imagen" accept=".png,.jpg,.jpeg">
        </div>
      </div>

      <div class="buttons">
        <button class="button is-warning" type="submit">Guardar cambios</button>
        <a href="/albumes" class="button is-light">Cancelar</a>
      </div>
    </form>
  </div>
</section>

<%- include('includes/footer.ejs') %>