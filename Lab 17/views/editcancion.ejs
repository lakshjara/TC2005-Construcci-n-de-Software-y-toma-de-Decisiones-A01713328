<%- include('includes/head.ejs') %>
<%- include('includes/nav.ejs') %>
<section class="section">
  <div class="container">
    <h1 class="title">Editar canción</h1>
    <form action="/canciones/<%= cancion.id %>/edit" method="POST">
      <div class="field">
        <label class="label">Título</label>
        <div class="control">
          <input class="input" type="text" name="titulo" value="<%= cancion.titulo %>">
        </div>
      </div>
      <div class="field">
        <label class="label">Artista</label>
        <div class="control">
          <input class="input" type="text" name="artista" value="<%= cancion.artista %>">
        </div>
      </div>
      <div class="field">
        <label class="label">URL de la portada</label>
        <div class="control">
          <input class="input" type="text" name="imagen" value="<%= cancion.imagen %>">
        </div>
      </div>
      <div class="buttons">
        <button class="button is-warning" type="submit">Guardar cambios</button>
        <a href="/canciones" class="button is-light">Cancelar</a>
      </div>
    </form>
  </div>
</section>
<%- include('includes/footer.ejs') %>